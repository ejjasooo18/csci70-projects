        <mxCell id="M2-r1" edge="1" parent="1" source="M2-NUM" target="PtFCRhkSz_Lgp6Lw95VS-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.29;entryY=0;entryDx=0;entryDy=0;strokeColor=#777777;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="574" y="850" /><mxPoint x="110" y="850" /><mxPoint x="110" y="50" /><mxPoint x="573" y="50" /></Array></mxGeometry></mxCell>
        <mxCell id="M2-r2" edge="1" parent="1" source="M2-E2" target="PtFCRhkSz_Lgp6Lw95VS-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.49;entryY=0;entryDx=0;entryDy=0;strokeColor=#777777;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="755" y="880" /><mxPoint x="85" y="880" /><mxPoint x="85" y="35" /><mxPoint x="584" y="35" /></Array></mxGeometry></mxCell>
        <mxCell id="M2-r3" edge="1" parent="1" source="M2-S26" target="PtFCRhkSz_Lgp6Lw95VS-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.73;entryY=0;entryDx=0;entryDy=0;strokeColor=#777777;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="900" /><mxPoint x="60" y="900" /><mxPoint x="60" y="20" /><mxPoint x="597" y="20" /></Array></mxGeometry></mxCell>
        <mxCell id="M2-legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;States&lt;/b&gt;&lt;br&gt;single circle &amp;mdash; non-accepting state&lt;br&gt;double circle &amp;mdash; accepting state; the label is the token emitted&lt;br&gt;process box (E1&amp;ndash;E4) &amp;mdash; lexical error state&lt;br&gt;red double circle &amp;mdash; emits a token &lt;i&gt;and&lt;/i&gt; reports an error&lt;br&gt;&lt;br&gt;&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;solid &amp;mdash; the character is consumed&lt;br&gt;dashed, &lt;i&gt;other /*&lt;/i&gt; &amp;mdash; emit the token and retract 1 character (maximal-munch backtrack)&lt;br&gt;grey &amp;mdash; return to the S0 hub. Every accepting and error state returns to S0.&lt;br&gt;&lt;br&gt;&lt;b&gt;Alphabet&lt;/b&gt;&lt;br&gt;&lt;b&gt;letter&lt;/b&gt; = A&amp;ndash;Z | a&amp;ndash;z&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;digit&lt;/b&gt; = 0&amp;ndash;9&lt;br&gt;&lt;b&gt;ws&lt;/b&gt; = space | tab | newline (newline increments the line counter)&lt;br&gt;&lt;b&gt;other&lt;/b&gt; = any character with no other transition out of that state&lt;br&gt;Literal characters are written as themselves; &lt;b&gt;&amp;quot;.&amp;quot;&lt;/b&gt; is quoted so the dot is legible." vertex="1"><mxGeometry height="300" width="265" x="890" y="20" as="geometry" /></mxCell>
        <mxCell id="M2-key" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;STATE KEY &amp;mdash; Number sub-DFA&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;S20&lt;/b&gt;&amp;nbsp; integer digits &amp;mdash; accepting&lt;br&gt;&lt;b&gt;S21&lt;/b&gt;&amp;nbsp; dot seen, needs a digit&lt;br&gt;&lt;b&gt;S22&lt;/b&gt;&amp;nbsp; fraction digits &amp;mdash; accepting&lt;br&gt;&lt;b&gt;S23&lt;/b&gt;&amp;nbsp; after the e | E exponent marker&lt;br&gt;&lt;b&gt;S24&lt;/b&gt;&amp;nbsp; after the exponent sign&lt;br&gt;&lt;b&gt;S25&lt;/b&gt;&amp;nbsp; exponent digits &amp;mdash; accepting&lt;br&gt;&lt;b&gt;S26&lt;/b&gt;&amp;nbsp; stray dot: emit Number, then report E2&lt;br&gt;&lt;b&gt;E2&lt;/b&gt;&amp;nbsp;&amp;nbsp; Invalid number format&lt;br&gt;&lt;br&gt;&lt;i&gt;All three accepting states emit the same &lt;b&gt;Number&lt;/b&gt; token, so they share one accept node.&lt;/i&gt;" vertex="1"><mxGeometry height="205" width="320" x="140" y="930" as="geometry" /></mxCell>
        <mxCell id="M2-cons" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;CONSTRAINTS &amp;amp; DESIGN NOTES &amp;mdash; Number sub-DFA&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Maximal munch.&lt;/b&gt; The scanner takes the longest valid prefix, emits it, and restarts at the offending character. Dashed &lt;i&gt;other /*&lt;/i&gt; arrows retract that character; solid arrows consume it.&lt;br&gt;&lt;b&gt;2. The arrows into E2 consume the offending character&lt;/b&gt; (solid, not dashed). &lt;i&gt;3e+e3&lt;/i&gt; &amp;rarr; E2 over &lt;i&gt;3e+e&lt;/i&gt;, then &lt;i&gt;Number 3&lt;/i&gt;. &lt;i&gt;3.2east&lt;/i&gt; &amp;rarr; E2 over &lt;i&gt;3.2ea&lt;/i&gt;, then &lt;i&gt;Identifier st&lt;/i&gt;.&lt;br&gt;&lt;b&gt;3. A dot enters the lexeme only if no dot and no exponent has been seen yet.&lt;/b&gt; S20 &amp;rarr; S21 is tentative: &lt;i&gt;98.76&lt;/i&gt; is a Number, but &lt;i&gt;76.&lt;/i&gt; is E2 with &lt;u&gt;no&lt;/u&gt; Number emitted. From S22 or S25 a further dot is stray and goes to S26.&lt;br&gt;&lt;b&gt;4. S26 emits the completed Number first, then reports E2&lt;/b&gt;, consuming the dot. &lt;i&gt;111.222e333.444&lt;/i&gt; &amp;rarr; Number 111.222e333, E2, Number 444.&lt;br&gt;&lt;b&gt;5. + and - are never part of a number&lt;/b&gt; except at S23 &amp;rarr; S24, immediately after e | E. &lt;i&gt;3 - 2 - 1&lt;/i&gt; &amp;rarr; Number, Minus, Number, Minus, Number, while &lt;i&gt;9.8E+7&lt;/i&gt; is one Number. No sign arrow leaves S0 toward this sub-machine.&lt;br&gt;&lt;b&gt;6. e | E leaving S0 is a letter&lt;/b&gt; (S0 &amp;rarr; S1, Identifier). The exponent arrows leave S20 and S22 only. &lt;i&gt;e+e&lt;/i&gt; &amp;rarr; Identifier e, Plus, Identifier e.&lt;br&gt;&lt;b&gt;7. Keywords are not drawn&lt;/b&gt; &amp;mdash; Identifiers are re-classified by a case-sensitive post-scan lookup (spec, slide 9)." vertex="1"><mxGeometry height="205" width="680" x="480" y="930" as="geometry" /></mxCell>
